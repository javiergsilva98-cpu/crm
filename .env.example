NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para el servidor: crea/gestiona cuentas desde /usuarios. Nunca
# se expone al navegador (no lleva el prefijo NEXT_PUBLIC_). Está en
# Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Cualquier valor secreto que elijas tú (p. ej. generado con
# `openssl rand -hex 32`). Protege /api/cron/keepalive, que Vercel Cron
# llama una vez al día para que Supabase no se autopause por
# inactividad. Configúralo igual en Vercel → Project Settings →
# Environment Variables — Vercel lo manda solo al llamar al cron.
CRON_SECRET=
